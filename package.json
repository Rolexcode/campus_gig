{
  "name": "campusgig",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .output --ignore-pattern .next",
    "test": "vitest run --exclude e2e/**",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:authenticated": "node scripts/run-authenticated-e2e.mjs",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,storage --project campusgig-e2e",
    "reset:data": "node scripts/reset-marketplace-data.mjs",
    "escrow:init": "node scripts/initialize-program-escrow.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.20.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "^15.31.0",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
