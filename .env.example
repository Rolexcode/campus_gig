# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local/CI test isolation only. Never enable these values in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
# Public support address shown in the help, trust, and policy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# High-entropy bearer secret for the token-protected dependency readiness probe:
# GET /api/health?deep=1. Generate independently; never use a user password.
HEALTH_CHECK_TOKEN=

# Managed attachment scanner. The HTTPS service receives multipart form data
# (`file`, `sha256`) and must return JSON with verdict=clean, scanId, engine, and
# optionally the same sha256. Production file sharing fails closed without it.
CHAT_ATTACHMENT_SCANNER_URL=
CHAT_ATTACHMENT_SCANNER_TOKEN=
# Abandoned quarantine objects are deleted by the authenticated daily cron.
CRON_SECRET=
CHAT_ATTACHMENT_QUARANTINE_TTL_HOURS=24

# Server-only email provider credentials. Never prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CampusGig <onboarding@resend.dev>
# Independent high-entropy secret for hashing short-lived student email codes.
# Generate with the same command used for WALLET_ENCRYPTION_KEY.
STUDENT_VERIFICATION_HMAC_SECRET=

# JSON mapping of institution email domains to their canonical institution.
# Unlisted domains must use manual student-ID verification.
SCHOOL_EMAIL_DOMAINS_JSON={"st.lasu.edu.ng":"Lagos State University"}

# Comma-separated emails allowed to open the admin console.
ADMIN_EMAILS=

# Absolute path to a Firebase Admin service-account JSON file stored outside this project.
GOOGLE_APPLICATION_CREDENTIALS=

# Serverless alternative: the complete minified Firebase service-account JSON.
# Use this on Vercel instead of GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Preferred on Vercel: base64 of the complete service-account JSON file.
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=

# Server-only 32-byte base64 key used to encrypt embedded Solana wallet secrets.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=

# Solana Devnet payment configuration. The default mint below is Circle's
# official Devnet USDC mint. Keep RPC credentials server-only.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Keep `custodial` until the Anchor program is built, deployed, initialized,
# independently reviewed, and its config is verified. Then change to `program`.
SOLANA_SETTLEMENT_MODE=custodial
SOLANA_ESCROW_PROGRAM_ID=5xcjvcVCAbdrJtzRZv8UkeGhTPTFGAiTTeLLauKam7d8
# Local deployment/init only. Never add this upgrade-authority secret to Vercel.
SOLANA_PROGRAM_UPGRADE_AUTHORITY_SECRET_KEY_BASE64=
SOLANA_PAUSE_AUTHORITY_ADDRESS=
SOLANA_DISPUTE_AUTHORITY_ADDRESS=
# Optional but recommended: a dedicated Devnet keypair, encoded as base64.
# When set, CampusGig pays network fees and token-account rent so users need no SOL.
SOLANA_FEE_PAYER_SECRET_KEY_BASE64=
# Dedicated Devnet dispute authority used only for program-escrow resolutions.
# Production must use a multisig/controlled signer rather than a raw app secret.
SOLANA_DISPUTE_AUTHORITY_SECRET_KEY_BASE64=
CAMPUSGIG_PLATFORM_FEE_BPS=500
# Public Solana wallet that receives CampusGig's USDC platform fee.
CAMPUSGIG_FEE_WALLET_ADDRESS=
# Emergency server-side kill switch. Set true to block funding and release.
PAYMENTS_PAUSED=false

# Flutterwave NGN dynamic virtual-account funding. These values are server-only.
# Configure the same random webhook secret hash in Flutterwave Dashboard and point
# the webhook URL to https://YOUR_DOMAIN/api/webhooks/flutterwave.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
