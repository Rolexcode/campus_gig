# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only email provider credentials. Never prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CampusGig <onboarding@resend.dev>

# Comma-separated emails allowed to open the admin console.
ADMIN_EMAILS=

# Absolute path to a Firebase Admin service-account JSON file stored outside this project.
GOOGLE_APPLICATION_CREDENTIALS=

# Serverless alternative: the complete minified Firebase service-account JSON.
# Use this on Vercel instead of GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Preferred on Vercel: base64 of the complete service-account JSON file.
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=

# Server-only 32-byte base64 key used to encrypt embedded Solana wallet secrets.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=

# Solana Devnet payment configuration. The default mint below is Circle's
# official Devnet USDC mint. Keep RPC credentials server-only.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
CAMPUSGIG_PLATFORM_FEE_BPS=500
