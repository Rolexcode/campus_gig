rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validNewProfile(userId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'emailVerified',
          'studentVerified',
          'verificationStatus',
          'onboardingComplete',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'emailVerified',
          'studentVerified',
          'verificationStatus',
          'onboardingComplete',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.emailVerified == false
        && request.resource.data.studentVerified == false
        && request.resource.data.verificationStatus == 'unsubmitted'
        && request.resource.data.onboardingComplete == false;
    }

    function updatesOnlyEditableProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fullName',
        'country',
        'university',
        'course',
        'headline',
        'bio',
        'skills',
        'portfolio',
        'linkedIn',
        'gitHub',
        'availability',
        'photoName',
        'photoDataUrl',
        'onboardingComplete',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      allow get: if ownsProfile(userId);
      allow list: if false;
      allow create: if ownsProfile(userId) && validNewProfile(userId);
      allow update: if ownsProfile(userId) && updatesOnlyEditableProfileFields();
      allow delete: if false;
    }

    // Marketplace data is accessed through authenticated server routes. The
    // Admin SDK performs ownership and account-status checks before writes.
    match /gigs/{gigId} {
      allow read, write: if false;
    }

    match /applications/{applicationId} {
      allow read, write: if false;
    }

    // Gig conversations, messages, and agreement state are server-only. API
    // routes verify that the caller is the poster or the selected student.
    match /gigConversations/{gigId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Custodial wallet secrets are server-only. The public address is stored
    // on the user's own profile; encrypted key material is never client-readable.
    match /walletKeys/{userId} {
      allow read, write: if false;
    }

    // Payment state and per-gig custodial escrow keys are server-only.
    match /gigPayments/{gigId} {
      allow read, write: if false;
    }

    match /paymentWalletKeys/{gigId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
